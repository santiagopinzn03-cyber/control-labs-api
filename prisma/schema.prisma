generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model equipment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  placa_sena     String           @unique @db.VarChar(50)
  codigo_activo  String           @unique @db.VarChar(100)
  tipo           String           @db.VarChar(50)
  room_id        String           @db.Uuid
  estado         String           @default("OPERATIVO") @db.VarChar(20)
  rooms          rooms            @relation(fields: [room_id], references: [id], onUpdate: NoAction)
  incidents      incidents[]
  loan_equipment loan_equipment[]

  @@index([room_id], map: "idx_equipment_room")
}

model incidents {
  id           BigInt    @id @default(autoincrement())
  equipment_id String    @db.Uuid
  reported_by  String    @db.Uuid
  descripcion  String
  prioridad    String    @db.VarChar(10)
  estado       String    @default("PENDIENTE") @db.VarChar(16)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  equipment    equipment @relation(fields: [equipment_id], references: [id], onUpdate: NoAction)
  users        users     @relation(fields: [reported_by], references: [id], onUpdate: NoAction)

  @@index([equipment_id, estado], map: "idx_incidents_equipment_status")
}

model loan_equipment {
  loan_id      BigInt
  equipment_id String    @db.Uuid
  assigned_at  DateTime  @default(now()) @db.Timestamptz(6)
  returned_at  DateTime? @db.Timestamptz(6)
  equipment    equipment @relation(fields: [equipment_id], references: [id], onUpdate: NoAction)
  loans        loans     @relation(fields: [loan_id], references: [id], onUpdate: NoAction)

  @@id([loan_id, equipment_id])
}

model loans {
  id               BigInt           @id @default(autoincrement())
  room_id          String           @db.Uuid
  instructor_id    String           @db.Uuid
  guarda_id        String           @db.Uuid
  numero_pc        Int
  estado           String           @default("PENDIENTE_APROBACION") @db.VarChar(24)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  accepted_at      DateTime?        @db.Timestamptz(6)
  loan_equipment   loan_equipment[]
  users_guarda     users            @relation("loans_guarda_idTousers", fields: [guarda_id], references: [id], onUpdate: NoAction)
  users_instructor users            @relation("loans_instructor_idTousers", fields: [instructor_id], references: [id], onUpdate: NoAction)
  rooms            rooms            @relation(fields: [room_id], references: [id], onUpdate: NoAction)

  @@index([room_id, created_at(sort: Desc)], map: "idx_loans_room_created")
}

model rooms {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre        String      @unique @db.VarChar(100)
  bloque        String      @db.VarChar(50)
  capacidad_pcs Int
  estado        String      @default("OPERATIVO") @db.VarChar(20)
  equipment     equipment[]
  loans         loans[]
}

model users {
  id                         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                      String      @unique @db.VarChar(255)
  nombre                     String      @db.VarChar(150)
  rol                        String      @db.VarChar(20)
  activo                     Boolean     @default(true)
  created_at                 DateTime    @default(now()) @db.Timestamptz(6)
  incidents                  incidents[]
  loans_guarda_idTousers     loans[]     @relation("loans_guarda_idTousers")
  loans_instructor_idTousers loans[]     @relation("loans_instructor_idTousers")
}
